{
  "name": "editor-liveries-ac",
  "version": "1.0.0",
  "description": "Editor 3D de liveries para Assetto Corsa con interfaz tipo Gran Turismo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "acorn": "^8.17.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.editorliveries.assetto",
    "productName": "Editor Liveries AC",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "kn5-main-module.js",
      "kn5-preload-api.js",
      "kn5-renderer-controller.mjs",
      "package.json",
      "logo.png",
      "logosinfondo.png",
      "ui_skin.json",
      "derelict_airfield_02_1k.hdr",
      "node_modules/three/**",
      "node_modules/dxt-js/**"
    ],
    "extraResources": [
      {
        "from": "kn5-tools",
        "to": "kn5-tools",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  },
  "dependencies": {
    "dxt-js": "^0.0.3",
    "three": "^0.160.0"
  }
}
